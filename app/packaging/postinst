#!/bin/sh
# Let members of plugdev (the CardputerZero user "pi" is one) run the gadget helper
# without a password. The rule is checked with visudo before it goes in place.
set -e
if [ "$1" = configure ]; then
    tmp=$(mktemp)
    printf '%s\n' \
        '# DiscPuter: switch the USB optical drive emulation (helper only accepts image folders)' \
        '%plugdev ALL=(root) NOPASSWD: /usr/libexec/discputer/dp-gadget' > "$tmp"
    if visudo -cf "$tmp" >/dev/null 2>&1; then
        install -m 0440 -o root -g root "$tmp" /etc/sudoers.d/discputer
    else
        echo "discputer: sudoers rule failed the check, not installed" >&2
    fi
    rm -f "$tmp"
fi
exit 0
