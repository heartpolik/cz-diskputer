#!/usr/bin/env bash
# DiscPuter USB gadget helper: show a disc image to a computer as a USB CD-ROM (or a
# read-only disk) through the Linux mass-storage gadget. Installed as
# /usr/libexec/discputer/dp-gadget and run by the app through sudo (see /etc/sudoers.d/discputer),
# so it only accepts images inside an images folder: ~/discputer/images, /media, /mnt.
#
#   sudo cz-gadget.sh up <image> [cd|disk]   create the gadget and "insert" the image
#   sudo cz-gadget.sh swap <image> [replug]  change the disc (replug: also reconnect USB,
#                                            for hosts that miss the media change, e.g. macOS)
#   sudo cz-gadget.sh replug                 disconnect and reconnect USB (host re-reads the drive)
#   sudo cz-gadget.sh eject                  take the disc out (drive stays)
#   sudo cz-gadget.sh status                 what the host sees
#   sudo cz-gadget.sh down                   remove the gadget
#   sudo cz-gadget.sh drop                   be a USB flash drive (exFAT, label DISCPUTER) to copy
#                                            images onto from the computer
#   sudo cz-gadget.sh import                 after the computer ejected it: move what was copied
#                                            into ~/discputer/images
#
# The Host/Slave switch on the left side must be on Slave: then the CM0 USB goes to
# the RIGHT USB-C port (the USB hub, Ethernet and USB-A are off while it is there).
#
# cd   : SCSI CD-ROM (ISO 9660 / El Torito boot), what installers on CD expect.
# disk : read-only removable disk; better for "hybrid" Linux ISOs and some UEFI firmware.
set -euo pipefail
export PATH=/usr/sbin:/sbin:/usr/bin:/bin

G=/sys/kernel/config/usb_gadget/discputer
F=$G/functions/mass_storage.usb0
LUN=$F/lun.0
# the copy-in flash drive: root's own, outside the user's home (no symlink games)
DROP_DIR=/var/lib/discputer
DROP=$DROP_DIR/drop.img
DROP_MNT=/run/discputer/drop
GiB=$((1024 * 1024 * 1024))

die() { echo "error: $*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "run as root (sudo)"; }

udc_name() {
    local u
    u=$(ls /sys/class/udc 2>/dev/null | head -1)
    [[ -n $u ]] || die "no USB device controller (dwc2 must be in otg/peripheral mode)"
    echo "$u"
}

check_image() {
    local img=$1 real user home
    [[ -n $img ]] || die "no image given"
    real=$(readlink -f -- "$img") || die "no such image: $img"
    [[ -f $real ]] || die "no such image: $img"
    user=${SUDO_USER:-$(id -un)}
    home=$(getent passwd "$user" | cut -d: -f6)
    case $real in
        "$home"/discputer/images/*|/media/*|/mnt/*) ;;
        *) die "images must be in $home/discputer/images, /media or /mnt" ;;
    esac
    # the user who asked must be able to read it themselves
    if [[ $user != root ]]; then
        runuser -u "$user" -- test -r "$real" || die "not readable by $user: $img"
    fi
    echo "$real"
}

up() {
    need_root
    local img mode=${2:-cd}
    img=$(check_image "${1:-}")
    [[ $mode == cd || $mode == disk ]] || die "mode is cd or disk"
    [[ $(lun_mode) == drop && -n $(cat "$LUN/file" 2>/dev/null) ]] &&
        die "the USB flash drive is in use: eject it on the computer first"
    build_gadget "$img" "$mode"
    echo "up: $(basename "$img") as $mode on $(cat "$G/UDC")"
    wait_configured
}

# mode: cd | disk (read-only) | drop (writable flash drive)
build_gadget() {
    local img=$1 mode=$2
    if [[ -d $G ]]; then
        echo "gadget was up: restarting it"
        down >/dev/null
    fi

    modprobe libcomposite
    modprobe usb_f_mass_storage
    mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config

    mkdir -p "$G"
    echo 0x1d6b > "$G/idVendor"    # Linux Foundation
    echo 0x0104 > "$G/idProduct"   # Multifunction Composite Gadget
    echo 0x0100 > "$G/bcdDevice"
    echo 0x0200 > "$G/bcdUSB"
    mkdir -p "$G/strings/0x409"
    echo "CardputerZero" > "$G/strings/0x409/manufacturer"
    echo "DiscPuter" > "$G/strings/0x409/product"
    echo "DP$(cut -c9-16 /proc/device-tree/serial-number 2>/dev/null || echo 00000001)" > "$G/strings/0x409/serialnumber"

    mkdir -p "$G/configs/c.1/strings/0x409"
    echo "DiscPuter" > "$G/configs/c.1/strings/0x409/configuration"
    echo 250 > "$G/configs/c.1/MaxPower"

    mkdir -p "$F"
    echo 1 > "$F/stall"
    echo 1 > "$LUN/removable"
    # vendor(8) product(16) revision(4)
    if [[ $mode == cd ]]; then
        echo 1 > "$LUN/ro"
        echo 1 > "$LUN/cdrom"
        printf '%-8s%-16s%-4s' "CZ" "DiscPuter CD" "0001" > "$LUN/inquiry_string"
    elif [[ $mode == disk ]]; then
        echo 1 > "$LUN/ro"
        echo 0 > "$LUN/cdrom"
        printf '%-8s%-16s%-4s' "CZ" "DiscPuter Disk" "0001" > "$LUN/inquiry_string"
    else
        echo 0 > "$LUN/ro"
        echo 0 > "$LUN/cdrom"
        printf '%-8s%-16s%-4s' "CZ" "DiscPuter USB" "0001" > "$LUN/inquiry_string"
    fi
    echo "$img" > "$LUN/file"
    ln -s "$F" "$G/configs/c.1/"

    udc_name > "$G/UDC"
}

# cd | disk | drop | none
lun_mode() {
    [[ -d $LUN ]] || { echo none; return; }
    if [[ $(cat "$LUN/cdrom") == 1 ]]; then echo cd
    elif [[ $(cat "$LUN/ro") == 1 ]]; then echo disk
    else echo drop; fi
}

user_home() {
    local user=${SUDO_USER:-$(id -un)}
    getent passwd "$user" | cut -d: -f6
}

# ------------------------------------------------------------ copy-in flash drive

drop() {
    need_root
    [[ $(lun_mode) == drop && -n $(cat "$LUN/file" 2>/dev/null) ]] && { echo "USB flash drive: already in"; return; }
    mountpoint -q "$DROP_MNT" && umount "$DROP_MNT"
    install -d -m 0700 -o root -g root "$DROP_DIR"
    if [[ ! -f $DROP || -L $DROP ]]; then
        rm -f "$DROP"
        # sparse: takes only what the computer writes; leave 2 GiB free, at most 64 GiB
        local avail size
        avail=$(df --output=avail -B1 "$DROP_DIR" | tail -1)
        size=$(( avail - 2 * GiB ))
        (( size > 64 * GiB )) && size=$(( 64 * GiB ))
        (( size >= GiB )) || die "not enough free space on the SD card for a USB drive"
        size=$(( size / (1024 * 1024) * 1024 * 1024 ))
        truncate -s "$size" "$DROP"
        mkfs.exfat -L DISCPUTER "$DROP" >/dev/null || { rm -f "$DROP"; die "mkfs.exfat failed"; }
        echo "new USB drive: $(( size / GiB )) GiB"
    fi
    build_gadget "$DROP" drop
    echo "USB flash drive DISCPUTER on $(cat "$G/UDC")"
    wait_configured
}

# The computer ejected the drive (or the user says it is done): take it away from USB and
# move every file on it into the user's images folder. File work runs as that user.
import() {
    need_root
    local user home images uid gid
    user=${SUDO_USER:-$(id -un)}
    home=$(user_home)
    images=$home/discputer/images
    uid=$(id -u "$user")
    gid=$(id -g "$user")
    [[ -f $DROP && ! -L $DROP ]] || die "no USB drive to import from"
    if [[ $(lun_mode) == drop ]]; then
        down >/dev/null
        sync
    fi
    runuser -u "$user" -- mkdir -p "$images"
    fsck.exfat -p "$DROP" >/dev/null 2>&1 || true
    mkdir -p "$DROP_MNT"
    mountpoint -q "$DROP_MNT" ||
        mount -t exfat -o loop,nosuid,nodev,noexec,uid="$uid",gid="$gid",umask=022 "$DROP" "$DROP_MNT" ||
        die "can't mount the USB drive"

    local n=0 left=0 src name dest base ext i avail need
    while IFS= read -r -d '' src; do
        name=$(basename -- "$src")
        dest=$images/$name
        if runuser -u "$user" -- test -e "$dest"; then
            base=${name%.*}; ext=${name##*.}
            [[ $base == "$name" ]] && ext="" || ext=.$ext
            i=2
            while runuser -u "$user" -- test -e "$images/$base ($i)$ext"; do i=$((i + 1)); done
            dest="$images/$base ($i)$ext"
        fi
        need=$(( $(stat -c %s -- "$src") + 512 * 1024 * 1024 ))
        avail=$(df --output=avail -B1 "$images" | tail -1)
        if (( avail < need )); then
            left=$((left + 1))
            continue
        fi
        echo "importing $name"
        if runuser -u "$user" -- cp --no-preserve=all -- "$src" "$dest.part" &&
            runuser -u "$user" -- mv -- "$dest.part" "$dest"; then
            rm -f -- "$src"
            n=$((n + 1))
        else
            runuser -u "$user" -- rm -f -- "$dest.part"
            left=$((left + 1))
        fi
    done < <(find "$DROP_MNT" -mindepth 1 \( -name '.*' -o -name 'System Volume Information' -o -name '$RECYCLE.BIN' \) -prune -o -type f -print0)
    umount "$DROP_MNT"

    if (( left == 0 )); then
        rm -f "$DROP"   # a fresh, empty drive next time
        echo "imported $n file$([[ $n == 1 ]] || echo s)"
    else
        echo "imported $n, $left left on the USB drive (not enough space?)"
    fi
}

swap() {
    need_root
    local img
    img=$(check_image "${1:-}")
    [[ -d $G ]] || die "gadget is not up"
    # the host may hold the medium locked; forced_eject ignores that
    echo 1 > "$LUN/forced_eject" 2>/dev/null || echo "" > "$LUN/file"
    sleep 1
    echo "$img" > "$LUN/file"
    echo "inserted: $(basename "$img")"
    [[ ${2:-} == replug ]] && replug
    return 0
}

# soft unplug + plug: the host drops the drive and enumerates it again with the current disc
replug() {
    need_root
    [[ -d $G ]] || die "gadget is not up"
    local udc
    udc=$(cat "$G/UDC")
    [[ -n $udc ]] || udc=$(udc_name)
    echo "" > "$G/UDC"
    sleep 1
    echo "$udc" > "$G/UDC"
    echo "reconnected"
    wait_configured
}

# the host needs a moment to enumerate after (re)connecting
wait_configured() {
    local u state
    for _ in $(seq 1 20); do
        for u in /sys/class/udc/*; do
            state=$(cat "$u/state" 2>/dev/null || true)
            [[ $state == configured ]] && { echo "host: configured"; return 0; }
        done
        sleep 0.25
    done
    echo "host: not configured yet (${state:-?}); check the switch (Slave) and the right USB-C"
}

eject() {
    need_root
    [[ -d $G ]] || die "gadget is not up"
    echo 1 > "$LUN/forced_eject" 2>/dev/null || echo "" > "$LUN/file"
    echo "ejected"
}

status() {
    if [[ ! -d $G ]]; then
        echo "gadget: down"
    else
        local udc file
        udc=$(cat "$G/UDC" 2>/dev/null || true)
        file=$(cat "$LUN/file" 2>/dev/null || true)
        echo "gadget: up (udc ${udc:-none}, mode $(lun_mode))"
        echo "disc:   ${file:-(empty)}"
    fi
    for u in /sys/class/udc/*; do
        [[ -e $u ]] || continue
        echo "usb:    $(basename "$u") state=$(cat "$u/state")"
    done
    echo "  (configured = the host enumerated us; not attached = cable/switch: Slave + right USB-C?)"
}

down() {
    need_root
    [[ -d $G ]] || { echo "gadget: down"; return; }
    echo "" > "$G/UDC" 2>/dev/null || true
    rm -f "$G/configs/c.1/mass_storage.usb0"
    rmdir "$G/configs/c.1/strings/0x409" "$G/configs/c.1" 2>/dev/null || true
    rmdir "$LUN" 2>/dev/null || true
    rmdir "$F" "$G/strings/0x409" "$G" 2>/dev/null || true
    echo "gadget: down"
}

cmd=${1:-status}
shift || true
case $cmd in
    up) up "$@" ;;
    swap) swap "$@" ;;
    replug) replug ;;
    eject) eject ;;
    status) status ;;
    down) down ;;
    drop) drop ;;
    import) import ;;
    *) sed -n '2,19p' "$0"; exit 1 ;;
esac
