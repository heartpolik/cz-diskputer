#!/bin/sh
# Take the virtual drive away before the helper goes; on removal the helper also takes
# out the sudo rule it added on the first run (dp-gadget setup).
set -e
H=/usr/lib/cz-discputer/dp-gadget
if [ -x "$H" ]; then
    if [ "$1" = remove ]; then
        "$H" uninstall >/dev/null 2>&1 || true
    else
        "$H" down >/dev/null 2>&1 || true
    fi
fi
exit 0
